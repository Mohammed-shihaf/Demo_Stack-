{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Unified backend service with Enterprise Clean Architecture (DDD), MongoDB 8, Elasticsearch 8, gRPC, and AWS SDK",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node -c src/server.js",
    "lint": "eslint src/ test/",
    "test": "cross-env NODE_ENV=test mocha \"test/**/*.test.js\"",
    "coverage": "cross-env NODE_ENV=test nyc --reporter=cobertura --reporter=text mocha \"test/**/*.test.js\"",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.677.0",
    "@aws-sdk/client-sns": "^3.677.0",
    "@elastic/elasticsearch": "^8.15.1",
    "@grpc/grpc-js": "^1.11.3",
    "@grpc/proto-loader": "^0.7.13",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "mongoose": "^8.7.0"
  },
  "devDependencies": {
    "@socketsecurity/cli": "^1.1.158",
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/mocha-runner": "^8.6.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "0.25.1",
    "git-spark": "^1.3.2",
    "gutcheck": "^0.8.0",
    "mocha": "^10.7.3",
    "mongodb-memory-server": "^10.1.2",
    "monocart-coverage-reports": "^2.13.0",
    "nyc": "^17.1.0",
    "oxlint": "^1.79.0",
    "supertest": "^7.0.0"
  }
}
